# Database
DB_NAME=worktogether
DB_USER=wt
DB_PASSWORD=changeme

# ── Accesso tramite Authentik (OIDC) ────────────────────────────────────────
# Issuer dell'applicazione Authentik (con la barra finale) e client id del provider pubblico (PKCE).
OIDC_ISSUER=https://auth.mchaservice.tech/application/o/worktogether/
OIDC_AUDIENCE=worktogether
# Opzionale: da dove scaricare le chiavi (JWKS). Vuoto = <OIDC_ISSUER>jwks/.
# Nella rete Docker: http://authentik-server:9000/application/o/worktogether/jwks/
OIDC_JWKS_URL=
# API di amministrazione di Authentik, per creare gli account dal pannello Amministrazione.
AUTHENTIK_API_URL=http://authentik-server:9000/api/v3
AUTHENTIK_API_TOKEN=
# Gruppo Authentik che dà accesso all'app (i nuovi account vengono aggiunti qui).
AUTHENTIK_USER_GROUP=worktogether
# Opzionale: chi accede con questa email (verificata da Authentik) diventa admin dell'app.
ADMIN_INIT_EMAIL=

# Frontend (build args): issuer e client id per oidc-client-ts
VITE_OIDC_AUTHORITY=https://auth.mchaservice.tech/application/o/worktogether/
VITE_OIDC_CLIENT_ID=worktogether

# Segreto per cifrare le chiavi dei provider AI (obbligatorio in produzione, lungo e casuale).
# Le installazioni che non lo avevano cifravano con JWT_SECRET: in quel caso copia qui il vecchio
# JWT_SECRET (o lascia JWT_SECRET impostato), altrimenti le chiavi salvate non si decifrano più.
AI_SECRET=

# Email (invio per ruoli dall'app). Per Gmail: usa una "app password" Google.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Mittente mostrato; di default usa MAIL_USERNAME
MAIL_FROM=

# Frontend: URL base API (lasciare vuoto per uso via nginx proxy)
VITE_API_URL=

# URL pubblico del frontend, usato per i link nelle email (es. accettazione inviti)
FRONTEND_BASE_URL=http://localhost:5173

# ── Voce / LiveKit (Fase 2) ──────────────────────────────────────────────────
# Lasciare vuoto per tenere la voce disattivata.
# LIVEKIT_URL = URL pubblico WSS che il browser usa per connettersi al media server
#   (es. wss://livekit.tuo-dominio.com). In locale senza TLS: ws://localhost:7880
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET devono combaciare con LIVEKIT_KEYS in docker-compose.
# Il secret deve essere lungo e casuale (min 32 caratteri).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=3600
