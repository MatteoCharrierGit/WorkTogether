# Produzione di WorkTogether sulla VPS: copia in `.env` (fuori da git) e compila i valori vuoti.
# Qui nessun segreto: i segreti si generano come descritto in docs/DEPLOY.md.

# --- URL pubblici ---
FRONTEND_BASE_URL=https://worktogether.mchaservice.tech
LIVEKIT_URL=wss://livekit.worktogether.mchaservice.tech

# --- Authentik (blueprint worktogether.yaml) ---
OIDC_ISSUER=https://auth.mchaservice.tech/application/o/worktogether/
OIDC_CLIENT_ID=worktogether
# JWKS e API dalla rete Docker `proxy`, senza uscire dalla VPS
OIDC_JWKS_URL=http://authentik-server:9000/application/o/worktogether/jwks/
AUTHENTIK_API_URL=http://authentik-server:9000/api/v3
AUTHENTIK_USER_GROUP=worktogether
ADMIN_INIT_EMAIL=

# --- Database (database e utente; la password è un segreto) ---
DB_NAME=worktogether
DB_USER=wt

# --- LiveKit ---
# Identificatore della chiave (non è un segreto): deve combaciare con webhook.api_key in livekit/livekit.vps.yaml
LIVEKIT_API_KEY=worktogether
# IP pubblico della VPS: le porte media di LiveKit si legano solo a questo
PUBLIC_IPV4=187.7.77.146

# --- Email (facoltativa: lasciare vuoto = nessuna mail) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_FROM=

# --- SEGRETI: da generare e incollare qui in `.env`, MAI in questo file (vedi docs/DEPLOY.md) ---
# DB_PASSWORD=
# AI_SECRET=
# LIVEKIT_API_SECRET=
# AUTHENTIK_API_TOKEN=
# MAIL_PASSWORD=
